# Statische Pruefung des OG3-Patches (clang-tidy). Aufruf: powershell -NoProfile -File tools\run_clang_tidy.ps1 -BuildDir <Build-Ordner>
# Bewusst eine kleine Auswahl: Fehlerquellen und teure Stellen, keine Stil- und Umbenennungsregeln.
# Nicht dabei, weil Hook-Code sie zwangslaeufig bricht: cppcoreguidelines-pro-type-* (reinterpret_cast auf Spielobjekte, Zeigerarithmetik mit
# festen Offsets), cppcoreguidelines-avoid-magic-numbers (Offsets und RVAs), modernize-* ausser den zwei unten.
# Nach der ersten Sichtung (2026-11-13) abgeschaltet, weil nur Fehlalarme:
#   cppcoreguidelines-pro-type-member-init   Ausgabe-Parameter, die die Engine fuellt (SVec3 r; g_sb.vecGetNormalized(&v, &r)), Layout-Huellklassen
#   clang-analyzer-cplusplus.Move            meldet std::sort mit Lambda (Stelle liegt in der Standardbibliothek)
#   performance-inefficient-string-concatenation, performance-no-automatic-move   nur Protokoll- und Ladepfade, nichts im Bildtakt
# Einzelne begruendete Ausnahmen stehen als NOLINT(<Pruefung>): <Grund> an der Zeile.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-exception-escape,
  -bugprone-branch-clone,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-deadcode.*,
  clang-analyzer-unix.Malloc,
  cppcoreguidelines-slicing,
  -clang-analyzer-cplusplus.Move,
  cppcoreguidelines-interfaces-global-init,
  misc-redundant-expression,
  misc-misplaced-const,
  misc-unused-using-decls,
  misc-definitions-in-headers,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  -performance-no-int-to-ptr,
  -performance-inefficient-string-concatenation,
  -performance-no-automatic-move,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-string-cstr,
  readability-container-size-empty
# Nur eigene Quellen melden (nicht AngelScript, MinHook, Windows-SDK)
HeaderFilterRegex: '.*[/\\](src|tests|tools)[/\\].*'
# Der Bestand ist frei von Meldungen; "-Strict" im Skript (und in der CI) laesst neue Meldungen scheitern
WarningsAsErrors: ''
FormatStyle: file
